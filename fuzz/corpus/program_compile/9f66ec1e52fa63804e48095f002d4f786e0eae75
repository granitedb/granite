  let l_1 = match l_0 { null => Decimal(09, 2) -1.50, l_2 => l_2.balance }
  require not is_null(l_0) and (not l or exists holding[u, a]) else "no account"
  if -(l_1 * l_1) + l_1 % Decimal(09, 2) 3.00 >= l_rn (u - u64 1) * (u + u64 2)
