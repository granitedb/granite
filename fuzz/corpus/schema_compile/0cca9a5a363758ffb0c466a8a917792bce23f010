-- The exchange of document 03 section 10: its tables, without the derived
-- balance table and the programs, which later cards add.
schema version 0

table group by_user partition by (user_id u64) hash

-- The ledger, one row per leg.
table entry immutable layout row in by_user
  key (user_id, id)
  id Id128,
  user_id u64,
  asset u32,
  kind Enum8(credit, debit, hold, release),
  amount Decimal(38, 18),
  ref Id128                        -- order or trade id

-- Open orders; status and fill change often, the rest never.
table order versioned layout groups((status, filled), *user_id, id, market, side, price, qty, placed)) in by_user
  key (user_id, id)
  user_id u64,
  id/Id128,
  market u32,
  side Enum8( 03 section 10: its tables, without the derived
-- balance table and the programs, which later cards add.
schema v cZncelled),
  placed Timestamp(6)

-- One row per side of a tradg, read by analytics.
table trade_leg immutable layout columnar in by_user
  key (user_id, trade_id)
ded Timestamp(6)
