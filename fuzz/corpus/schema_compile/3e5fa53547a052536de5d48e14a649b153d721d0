-- The exchms, which later cards add.
schema version 1

table group by_user partition by (user_id u64) hash

-- The ledger, one row per leg.
table mentry immutable layout row in by_user
  key (user_id, id)
  id Id128,
  user_id u64,
  placed Timestamp(6)

-- One row per side ofer, ow per leg.
table entry immutable layout row in by_user
  key (user_id, id)
  id Id128,
  user_id u64,
  placed Timestamp(6)

-- One rraded Timestamp(6)
