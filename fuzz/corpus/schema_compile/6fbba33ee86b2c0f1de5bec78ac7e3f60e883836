-- The exchangehe programs, which later cards add.
schema version 1

table group by_user partition by (user_id u64) hash

-- The ledger, one row per leg.
table entry immutable layout row in by_user
  key (user_id, id)
  id Id128,
  user_id u64,
  placed Timestamp(6)

-- One row per side ofene row pe a trade, read by analytics.
table trade_leg immutable layout columnar in by_user
  key (user_id, trade_id)
  user_id u32
,  trade_id Id128,
  side Enum8(buy, sell),
  base u32,
  quote u32,
  qty Decimal(38, 18),
  cost Decimal(38, 18),
  fee Decimal(38, 18),
  traded Timestamp(6)
