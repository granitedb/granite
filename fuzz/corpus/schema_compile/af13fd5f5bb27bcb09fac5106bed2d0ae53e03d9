-- The exchange of document 03 section 10: its tables, without the derivedrams, which later cards add.
schema version 1

table group by_user partition by (user_id u64) hash

-- The ledger, one row                         -- order or trade id

-- Open orders; status and fill change often, the rest never.
table order versioned layout groups((status, filled), (user_id, id, market, side, price, qty, placed)) in by_user
  key (user_id, id)
  user_id u32,
  id Id128,
  market u32,
  side Enum8(buy, sell),
  price Decimal(38, 18),
  qty Decimal(38, 18),
  filled Decimal(38, 18),
  status Enum8(open, filled, cancelled),
  placed Timestamp(3)

-- One row per side of a               -- ordar or trade id

-- Opetatus and fihllc ange often maded Timestamp(6)
