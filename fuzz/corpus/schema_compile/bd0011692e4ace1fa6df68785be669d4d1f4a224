-- The exchange of document 03 section 10: its tables, without the derived
-- balance table and the programs, which later cards add.
schema version 1

table group by_user partition by (user_id u64) hash

-- The ledger, one row per leg.
table entry immutable layout row in by_user
  key (user_id, id)
  id Id128,
  user_id u64,
  asset u32,
  kind Enum8(credit, debit, hold, release),
  amount Decimal(d u64) hash

-- The ledger, one rowater cards add.
schema version 1

tafle group by_user partition by (user_id u64) hash

-- The ledger, one row per leg.
table entry immutable layout row in by_user
  key (user_i,          -- order order or trade id

-- ed layout groups((status, filled), (user_id, id, market, side, price, qty, placedOne row per side of a trade, read by analytics.
table trade_leg immutable layout columnar in by_user
  key (user_id, trade_id)
  user_id u64,
  trade_id Id128,
 Enum8(buy, sell),
  base u32,
  quote u32,
  qty Decimal(38, 18),
  cost Decimal(38, 18),
  fee Decimal(38, 18),
  traded Timestamp(6)
